# Copy to .env (gitignored) and adjust as needed. All values are optional.

# Proxy listen port used by mitmproxy and injected as HTTPS_PROXY/HTTP_PROXY for copilot.
PROXY_PORT=8080

# Viewer server (HTTP + WebSocket) port.
VIEWER_PORT=8090

# Command used to launch the Copilot CLI (change if it's not on PATH as "copilot").
COPILOT_CMD=copilot

# Absolute path to the Copilot session store used for AIC/status enrichment.
# Defaults to %USERPROFILE%\.copilot\session-store.db when unset.
# COPILOT_SESSION_STORE=C:\Users\you\.copilot\session-store.db
