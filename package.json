{
  "name": "agent-loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trace GitHub Copilot CLI traffic and inspect LLM turns per session/context in a live web viewer.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "build": "vite build --config web/vite.config.ts",
    "dev": "vite --config web/vite.config.ts",
    "server": "node server/index.js",
    "trace": "node scripts/start-traced.js",
    "test": "node --test tests/capture.test.mjs",
    "test:diff": "node --test tests/diff.test.mjs",
    "test:contexts": "node --test tests/contexts.test.mjs",
    "test:unit": "node --test tests/diff.test.mjs tests/contexts.test.mjs",
    "test:addon": "python mitm/test_addon.py",
    "test:capture": "node --test tests/capture.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
